# SalesAgent AI — copy to .env and replace every placeholder.
NODE_ENV=production
PORT=3000
APP_BUILD_ID=replace-with-release-id
API_BASE_URL=http://127.0.0.1:3000
PUBLIC_BASE_URL=https://your-public-domain.example
FRONTEND_URL=https://your-public-domain.example
AUTO_MIGRATE=true

# `quick` creates a temporary URL. `named` uses a stable Cloudflare hostname.
CLOUDFLARE_TUNNEL_MODE=named
CLOUDFLARE_TUNNEL_TOKEN=

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# MySQL/MariaDB. jdbc:mysql URLs are accepted too, but mysql:// is preferred.
MYSQL_URL=mysql://db_user:url_encoded_password@db-host:3306/database_name
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# Text generation and embeddings through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_DEFAULT_MODEL=openrouter/auto
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_TIMEOUT_MS=12000
OPENROUTER_MAX_ATTEMPTS=2
OPENROUTER_STT_MODEL=deepgram/nova-3
OPENROUTER_STT_FALLBACK_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_STT_LANGUAGE=ru
OPENROUTER_STT_TIMEOUT_MS=30000
OPENROUTER_STT_MAX_ATTEMPTS=2

# Fast Cerebras inference. Add several keys separated by commas to distribute
# quota. Agent model references are stored as cerebras/gemma-4-31b.
CEREBRAS_API_KEYS=csk-replace-me,csk-replace-me-too
CEREBRAS_DEFAULT_MODEL=gemma-4-31b
CEREBRAS_FALLBACK_OPENROUTER_MODEL=openrouter/auto
CEREBRAS_TIMEOUT_MS=12000
CEREBRAS_MAX_KEY_ATTEMPTS=5
CEREBRAS_KEY_COOLDOWN_MS=60000

# Fish Audio TTS. The default can be overridden per agent in the admin UI.
FISH_AUDIO_API_KEY=replace-me
# Optional: actual Fish Audio voice/reference ID. This is not the API key.
FISH_AUDIO_DEFAULT_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_TIMEOUT_MS=8000
FISH_AUDIO_MAX_ATTEMPTS=2

# Cartesia Sonic 3.5 low-latency streaming TTS. Falls back to Fish Audio.
CARTESIA_API_KEY=sk_car_replace_me
CARTESIA_MODEL=sonic-3.5
# Natalya — Soothing Guide (Russian, feminine).
CARTESIA_DEFAULT_VOICE_ID=779673f3-895f-4935-b6b5-b031dc78b319
CARTESIA_VERSION=2026-03-01
CARTESIA_TIMEOUT_MS=5000
CARTESIA_MAX_ATTEMPTS=2

# Must match voiceSecret in Voximplant rule custom data.
VOICE_WEBHOOK_SECRET=replace-with-a-second-long-random-secret
VOICE_AUDIO_TTL_SECONDS=600
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_MAX_UPLOAD_MB=10
# Fast foreground voice replies. Complex questions are escalated in parallel
# to VOICE_DEEP_MODEL and delivered back through the fast model.
VOICE_FAST_MODEL=cerebras/gemma-4-31b
VOICE_FAST_MAX_TOKENS=120
VOICE_DEEP_MODEL=deepseek/deepseek-v4-pro
VOICE_DEEP_MAX_TOKENS=2400
VOICE_DEEP_TIMEOUT_MS=60000
ALLOW_INSECURE_VOICE_WEBHOOK=false

# Optional integrations.
VOXIMPLANT_ACCOUNT_ID=
VOXIMPLANT_API_KEY=
VOXIMPLANT_APP_NAME=salesagent
VOXIMPLANT_RULE_NAME=inbound
WAZZUP24_API_KEY=
WAZZUP24_CHANNEL_ID=
WAZZUP24_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://your-public-domain.example/api/crm/amocrm/callback
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_KNOWLEDGE=knowledge
S3_REGION=us-east-1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RAG_MAX_CANDIDATES=2000
WEBHOOK_BASE_URL=https://your-public-domain.example
