# ============================================================
# SalesAgent AI — переменные окружения
# Скопируйте в .env и заполните реальными значениями
# ============================================================

# --- Сервер ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesagent

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Google Gemini (Voice + Embeddings) ---
GOOGLE_API_KEY=AIza...
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_EMBED_MODEL=text-embedding-004

# --- Fish Audio (новый streaming TTS, пока opt-in) ---
FISH_API_KEY=
FISH_TTS_URL=wss://api.fish.audio/v1/tts/live
# Разрешайте другой WSS-host только для доверенного self-host/proxy.
FISH_TTS_ALLOW_CUSTOM_ENDPOINT=false
# WebSocket reference пока гарантированно документирует s2-pro.
# s2.1-pro включайте после smoke-test на своём аккаунте.
FISH_TTS_MODEL=s2-pro
FISH_TTS_REFERENCE_ID=
FISH_TTS_LATENCY=balanced
FISH_TTS_SAMPLE_RATE=8000
FISH_TTS_CHUNK_LENGTH=100
FISH_TTS_CONNECT_TIMEOUT_MS=10000
FISH_TTS_FIRST_AUDIO_TIMEOUT_MS=5000
FISH_TTS_FINISH_TIMEOUT_MS=10000

# --- Full-duplex voice pipeline ---
# Оставьте gemini до заполнения всех ключей и успешного smoke-test.
VOICE_RUNTIME=gemini
VOICE_DEFAULT_ORG_ID=
# Случайный секрет минимум 32 символа; setup-скрипт внедряет его в VoxEngine.
VOICE_WS_AUTH_TOKEN=
VOICE_ENDPOINTING_DELAY_MS=0
VOICE_SAFE_DRAFT=Секунду, уточняю.
VOICE_GREETING_TEXT=Здравствуйте! Я виртуальный помощник компании. Чем могу помочь?
VOICE_PLAYBACK_DRAIN_PADDING_MS=160
# Максимум одного WebSocket-сообщения и суммарной записи одного звонка.
VOICE_WS_MAX_PAYLOAD_BYTES=131072
VOICE_WS_MAX_BUFFERED_BYTES=131072
VOICE_RECORDING_MAX_BYTES=67108864
VOICE_LLM_FAST_MODEL=claude-haiku-4-5-20251001
VOICE_LLM_MEDIUM_MODEL=claude-sonnet-5
VOICE_LLM_DEEP_MODEL=claude-opus-4-8
VOICE_LLM_FAST_TIMEOUT_MS=600
VOICE_LLM_MEDIUM_TIMEOUT_MS=1800
VOICE_LLM_DEEP_TIMEOUT_MS=4000
VOICE_LLM_TOTAL_TIMEOUT_MS=5000

# --- Streaming STT: Deepgram Flux + AssemblyAI fallback ---
DEEPGRAM_API_KEY=
DEEPGRAM_STT_URL=wss://api.deepgram.com/v2/listen
DEEPGRAM_STT_ALLOW_CUSTOM_ENDPOINT=false
DEEPGRAM_STT_MODEL=flux-general-multi
DEEPGRAM_STT_LANGUAGE_HINT=ru
DEEPGRAM_STT_EOT_THRESHOLD=0.7
DEEPGRAM_STT_EOT_TIMEOUT_MS=1800
DEEPGRAM_STT_CONNECT_TIMEOUT_MS=5000
DEEPGRAM_STT_FINISH_TIMEOUT_MS=5000
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STT_URL=wss://streaming.assemblyai.com/v3/ws
# Fallback срабатывает только при ошибке открытия Deepgram, до первого аудио.
ASSEMBLYAI_STT_ALLOW_CUSTOM_ENDPOINT=false
ASSEMBLYAI_STT_MODEL=whisper-rt
ASSEMBLYAI_STT_MIN_TURN_SILENCE_MS=400
ASSEMBLYAI_STT_MAX_TURN_SILENCE_MS=1280
ASSEMBLYAI_STT_CONNECT_TIMEOUT_MS=5000
ASSEMBLYAI_STT_FINISH_TIMEOUT_MS=5000
ASSEMBLYAI_STT_FORCE_ENDPOINT_TIMEOUT_MS=750

# --- Voximplant (телефония КЗ/РУ) ---
VOXIMPLANT_ACCOUNT_ID=your-account-id
VOXIMPLANT_API_KEY=your-api-key
VOXIMPLANT_APP_NAME=salesagent
VOXIMPLANT_RULE_NAME=inbound

# --- Wazzup24 (WhatsApp) ---
WAZZUP24_API_KEY=your-wazzup-api-key
WAZZUP24_CHANNEL_ID=your-channel-id
WAZZUP24_WEBHOOK_SECRET=your-webhook-secret

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# --- AmoCRM (OAuth 2.0) ---
AMOCRM_CLIENT_ID=your-client-id
AMOCRM_CLIENT_SECRET=your-client-secret
AMOCRM_REDIRECT_URI=https://your-domain.com/api/crm/amocrm/callback

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_KNOWLEDGE=knowledge
S3_REGION=us-east-1

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Webhook base URL (для регистрации) ---
WEBHOOK_BASE_URL=https://your-domain.com
